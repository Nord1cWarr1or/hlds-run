#!/bin/bash
# Fake hlds_linux for tests/run.sh. Prints its argv, ignored-signal mask,
# LD_PRELOAD and extra fds, then acts per FAKE_MODE:
#   exit0 | segv | spam:<MiB> | longrun:<sec> | longsegv:<sec>
# fds are listed via ls into a file - a $(...) would itself hold a pipe fd.
echo "FAKE START pid=$$"
i=0; for a in "$@"; do i=$((i+1)); printf 'ARG%d=[%s]\n' "$i" "$a"; done
echo "SIGIGN=$(awk '/^SigIgn/{print $2}' /proc/$$/status)"
echo "PRELOAD=[${LD_PRELOAD-}]"
ls -l --color=never /proc/$$/fd > "$PWD/.fds" 2>/dev/null; printf 'FDS='; awk 'NR>1 && $9>2 && $9!=255 {printf "%s->%s ", $9, $11}' "$PWD/.fds"; echo; rm -f "$PWD/.fds"
case "${FAKE_MODE:-exit0}" in
  exit0) for n in $(seq 1 300); do echo "line $n"; done; exit 0 ;;
  segv)  for n in $(seq 1 150); do echo "line $n"; done; kill -SEGV $$ ;;
  spam:*) mb=${FAKE_MODE#spam:}; head -c $((mb*1024*1024)) /dev/zero | tr '\0' 'x' | fold -w 200; echo "SPAM DONE"; echo "FINISHED-OK" > "$PWD/finished"; exit 0 ;;
  longsegv:*) s=${FAKE_MODE#longsegv:}; for n in $(seq 1 $((s*10))); do echo "tick $n"; sleep 0.1; done; kill -SEGV $$ ;;
  longrun:*) s=${FAKE_MODE#longrun:}; for n in $(seq 1 $((s*10))); do echo "tick $n"; sleep 0.1; done; echo "FINISHED-OK" > "$PWD/finished"; exit 0 ;;
esac
