#!/bin/bash
#
#       HLDS crash-diagnostics wrapper, drop-in for Valve hlds_run.
#       Runs the server on a pty (console mirrored to terminal and to
#       a temp typescript); auto-restart with a crash-loop guard.
#       With -debug: core dumps + full crash reports (system state,
#       console tail, GDB analysis).
#
#       Improvements over the original Valve hlds_run:
#       - Real crash reports instead of a bare `bt` in debug.log:
#         signal, system state, engine env, md5 of the binary and all
#         .so, core dump settings, console tail, full GDB analysis
#         (bt full all threads, registers, mappings, shared libs).
#       - Every crash gets its own timestamped crash_report file
#         (original appends everything into one debug.log).
#       - Console capture via pty: operator keeps the live view and
#         the report gets the last 100 lines of both streams, CR and
#         ANSI codes stripped. Fallback to plain tty if `script` is
#         missing (with a warning).
#       - systemd-coredump supported: if core_pattern is a pipe
#         handler, the dump is exported via coredumpctl.
#       - Core dump management: after analysis the core is renamed
#         and old dumps are rotated (3 newest kept); original left
#         cores untracked.
#       - Crash-loop guard: gives up after repeated quick crashes
#         (original restarts forever).
#       - Debug mode: `ulimit -c unlimited` (original: 2000) and
#         MALLOC_CHECK_=3 heap-corruption detection. CAVEAT: the debug
#         malloc changes the heap layout - layout-sensitive crashes can
#         move or vanish entirely under -debug (verified live: crashes
#         at SteamGameServer_Init stopped reproducing with the preload
#         on glibc 2.41).
#       - Exit signal is decoded into a name in the report.
#       - Strict arg parsing: script-only args (-debug/-norestart/
#         -timeout/-binary) are never leaked to the server; missing
#         values or a non-numeric -timeout are hard errors (original
#         silently misparsed such lines).
#       - hlds_linux exit code is propagated with `script -e`
#         (some old wrapper versions always exited 0).
#

export LD_LIBRARY_PATH=".${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
set -o pipefail

# --- Temporary-state tracking + cleanup on any exit path ---
CAPLOG_FILE=""
GDB_CMDS_FILE=""
LAUNCHER_FILE=""
systemd_tmp_core=""

cleanup_temp() {
	[[ -n "$CAPLOG_FILE" ]] && { rm -f "$CAPLOG_FILE"; CAPLOG_FILE=""; }
	[[ -n "$GDB_CMDS_FILE" ]] && { rm -f "$GDB_CMDS_FILE"; GDB_CMDS_FILE=""; }
	[[ -n "$LAUNCHER_FILE" ]] && { rm -f "$LAUNCHER_FILE"; LAUNCHER_FILE=""; }
	[[ -n "$systemd_tmp_core" ]] && { rm -rf "$(dirname "$systemd_tmp_core")"; systemd_tmp_core=""; }
}

# Bash skips the EXIT trap on a fatal signal - route INT/TERM through exit.
trap 'trap - INT; exit 130' INT
trap 'trap - TERM; exit 143' TERM
trap cleanup_temp EXIT

# --- Global Configuration ---
GAME="valve"
DEBUG=0
RESTART="yes"
HL="./hlds_linux"
TIMEOUT=10
GDB="gdb"
# Crash-loop guard: stop after STREAK_LIMIT crashes that happened while the
# server ran for less than HEALTHY_UPTIME seconds (quick-fail loop).
STREAK_LIMIT=5
HEALTHY_UPTIME=300
# LD_PRELOAD path resolved by init() in -debug mode; applied to the
# server process only (not the wrapper's own helpers).
HEAP_PRELOAD=""
# --- End of Global Configuration ---


init() {
	SRV_ARGS=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		"-game") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; GAME="$2"; SRV_ARGS+=("-game" "$2"); shift 2 ;;
		"-binary") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; HL="$2"; shift 2 ;;
		"-timeout")
			[[ $# -ge 2 ]] || { echo "Error: '-timeout' requires a value."; exit 1; }
			[[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "Error: '-timeout' value must be a positive integer."; exit 1; }
			TIMEOUT="$2"; shift 2 ;;
		"-debug") DEBUG=1; shift ;;
		"-norestart") RESTART=""; shift ;;
		*) SRV_ARGS+=("$1"); shift ;;
		esac
	done
	if [[ ! -d "$GAME" ]]; then echo "Error: Invalid game type '$GAME'"; exit 1; fi
	if [[ ! -x "$HL" ]]; then echo "Error: Binary '$HL' not found or not executable."; exit 1; fi
	CAPTURE=1
	if ! command -v script &> /dev/null; then
		echo "Warning: 'script' not found - capture disabled, plain tty mode."
		CAPTURE=0
	fi
	if [[ "$DEBUG" -eq 1 ]]; then
		echo "Debug mode is enabled. Core dumps will be generated on crash."
		ulimit -c unlimited
		if [[ "$(ulimit -c)" == "0" ]]; then
			echo "Warning: core dumps could not be enabled (hard limit is 0 - container or service limits?)."
		fi
		if ! command -v "$GDB" &> /dev/null; then echo "Warning: 'gdb' not found."; fi
		# Loud heap-corruption detection for this debug session only.
		#
		# glibc >= 2.34 (Debian 12+, Arch, Ubuntu 22+): the debug malloc
		# lives in libc_malloc_debug.so and is NOT active unless preloaded.
		# On older glibc (Debian 11, CentOS) the variable works by itself.
		# Detect the 32-bit object (the HLDS binary is 32-bit); on systems
		# without it the plain MALLOC_CHECK_ export below still applies.
		local mdebug_lib ldconfig_bin candidate
		mdebug_lib="$(ldconfig -p 2>/dev/null | awk '/libc_malloc_debug/ && /\(libc6\) =>/ {print $NF; exit}')"
		if [[ -z "$mdebug_lib" ]]; then
			# ldconfig lives in /usr/sbin - not in a regular user's PATH
			# (e.g. the service user running this wrapper).
			for ldconfig_bin in /sbin/ldconfig /usr/sbin/ldconfig; do
				[[ -x "$ldconfig_bin" ]] || continue
				mdebug_lib="$("$ldconfig_bin" -p 2>/dev/null | awk '/libc_malloc_debug/ && /\(libc6\) =>/ {print $NF; exit}')"
				[[ -n "$mdebug_lib" ]] && break
			done
		fi
		if [[ -z "$mdebug_lib" ]]; then
			# Last resort: known multiarch locations of the 32-bit object.
			for candidate in /usr/lib/i386-linux-gnu/libc_malloc_debug.so.0 /usr/lib32/libc_malloc_debug.so.0 /lib32/libc_malloc_debug.so.0; do
				[[ -e "$candidate" ]] && { mdebug_lib="$candidate"; break; }
			done
		fi
		if [[ -n "$mdebug_lib" ]]; then
			# NOT exported globally: every 64-bit helper of the wrapper
			# (date, mktemp, script, launcher bash) would inherit it and
			# print "wrong ELF class: ELFCLASS32" noise. The preload is
			# injected into the launcher/env so only the server process
			# (32-bit) sees it.
			HEAP_PRELOAD="$mdebug_lib"
			echo "Heap debugging: $mdebug_lib will be preloaded into the server (glibc >= 2.34 requires it)."
		else
			HEAP_PRELOAD=""
			echo "Heap debugging: MALLOC_CHECK_ set natively (no libc_malloc_debug found)."
		fi
		export MALLOC_CHECK_=3
		# CAVEAT: even without the preload, on older glibc the native debug
		# malloc also rearranges the heap - layout-sensitive crashes can
		# move or vanish under -debug (see README, verified on Debian 13).
		# OPTIONAL: fill fresh allocations with garbage (0xAA) and freed memory
		# with ~0xAA so use-after-free and reads of freed/stale data trip almost
		# immediately. Adds memset on every malloc/free - noticeable overhead.
		# Works on every glibc, no preload needed. Note: with the preload the
		# heap layout differs from non-debug runs - crashes may surface at
		# different points. Uncomment for maximum-radar debugging sessions:
		# export MALLOC_PERTURB_=170
	fi
}

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] - $1"
}

# Capture: run on a pty so the operator keeps the live console view while
# a temp typescript collects stdout+stderr for the crash report tail.
LAUNCHER_FILE=""

make_launcher() {
	# `script -c` re-parses its command line through $SHELL (dash, fish...),
	# and printf %q quoting is bash-specific - a mismatched shell mangles
	# args with spaces/UTF-8. Instead: write a tiny launcher with a bash
	# shebang; whatever shell `script` uses, it just executes that file,
	# and the args are parsed by our bash. Reuses the %q technique, but
	# only where it is guaranteed valid.
	LAUNCHER_FILE=$(mktemp)
	printf '#!/bin/bash\n' > "$LAUNCHER_FILE"
	if [[ -n "$HEAP_PRELOAD" ]]; then
		# Set inside the launcher: `script` and the launcher bash itself
		# run without the variable (no ELF-class noise from 64-bit
		# helpers); `exec` passes it only to the server process.
		printf 'export LD_PRELOAD=%q\n' "$HEAP_PRELOAD" >> "$LAUNCHER_FILE"
	fi
	printf 'exec %q ' "$HL" >> "$LAUNCHER_FILE"
	local a
	for a in "${SRV_ARGS[@]}"; do printf '%q ' "$a" >> "$LAUNCHER_FILE"; done
	printf '2>&1\n' >> "$LAUNCHER_FILE"
	chmod +x "$LAUNCHER_FILE"
}

launch_server() {
	CONSOLE_TAIL=""
	# Keep the typescript on disk next to the server (never in /tmp:
	# on many systems it is tmpfs and a chatty console can eat RAM).
	# --output-limit is a runaway-console safety net (util-linux >= 2.32);
	# failures to apply it are harmless - the limit is far above the
	# ~100 lines the report actually reads.
	CAPLOG_FILE=$(mktemp "./.caplog.XXXXXX")
	# If the operator exported LD_PRELOAD themselves (e.g. following the
	# README instructions), 64-bit helpers like `script` would print
	# ELF-class noise into the console capture. The wrapper delivers the
	# preload through the launcher/env - the shell-level variable is
	# redundant here.
	if [[ -z "$HEAP_PRELOAD" ]] && [[ -n "$LD_PRELOAD" ]]; then
		unset LD_PRELOAD
	fi
	local limit_args=()
	if script --help 2>&1 | grep -q -- '--output-limit'; then
		limit_args=(--output-limit 200MiB)
	fi
	if [[ "$CAPTURE" -eq 1 ]]; then
		make_launcher
		if [[ ${#limit_args[@]} -gt 0 ]]; then
			script -q -e "${limit_args[@]}" "$CAPLOG_FILE" -c "\"$LAUNCHER_FILE\""
		else
			script -qec "\"$LAUNCHER_FILE\"" "$CAPLOG_FILE"
		fi
		local exitcode=$?
		rm -f "$LAUNCHER_FILE"; LAUNCHER_FILE=""
	else
		if [[ -n "$HEAP_PRELOAD" ]]; then
			# No capture: still scope the preload to the server only.
			env "LD_PRELOAD=$HEAP_PRELOAD" "$HL" "${SRV_ARGS[@]}"
		else
			"$HL" "${SRV_ARGS[@]}"
		fi
		local exitcode=$?
	fi
	if [[ -f "$CAPLOG_FILE" ]]; then
		# The pty turns \n into \r\n and the engine prints ANSI colors:
		# strip CRs and escape sequences, then drop `script` annotations.
		CONSOLE_TAIL=$(tail -n 100 "$CAPLOG_FILE" | tr -d '\r' | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | grep -v '^Script \(started\|done\)')
		rm -f "$CAPLOG_FILE"
		CAPLOG_FILE=""
	fi
	return $exitcode
}

debugcore() {
	local exitcode=$1
	local since_ts=${2:-0}
	# Clean stop (operator Ctrl+C or TERM) is never a crash - in either mode.
	if [[ $exitcode -eq 130 || $exitcode -eq 143 ]]; then return; fi
    if [[ $exitcode -eq 0 || $DEBUG -eq 0 ]]; then
        if [[ $exitcode -ne 0 ]]; then log_message "Server crashed, but debug mode is OFF."; fi
        return
    fi

    log_message "CRASH DETECTED (Exit Code: $exitcode). Generating comprehensive crash report..."

    local CRASH_LOG_FILE="crash_report_$(date +'%Y-%m-%d_%H-%M-%S.%N').txt"
    log_message "Crash report will be saved to: $CRASH_LOG_FILE"

    local CORE_FILE
    CORE_FILE=$(find . -maxdepth 1 -type f -name 'core*' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
    if [[ ! -f "$CORE_FILE" ]]; then
        CORE_FILE=""
    fi
    if [[ -n "$CORE_FILE" ]]; then
        # Never analyze a dump left by an earlier run: only cores created
        # after this server start are trustworthy. Also: a real core is
        # an ELF core file - anything else named core* is not ours.
        local core_mtime
        core_mtime=$(stat -c %Y "$CORE_FILE" 2>/dev/null || echo 0)
        if [[ $core_mtime -lt $since_ts ]] || ! file "$CORE_FILE" 2>/dev/null | grep -qE 'ELF.*(core|coredump)'; then
            log_message "Warning: newest core* is not a core dump from this server run - ignoring it."
            CORE_FILE=""
        fi
    fi

    # systemd-coredump: kernel.core_pattern is a pipe handler, so no core
    # file is written to disk. Try to export the latest matching dump via
    # coredumpctl (needs journal access; usually root). systemd_tmp_core
    # is a global, so the EXIT cleanup can remove leftovers.
    if [[ -z "$CORE_FILE" ]]; then
        local core_pattern
        core_pattern="$(cat /proc/sys/kernel/core_pattern 2>/dev/null)"
        if [[ "$core_pattern" == "|"* ]] && command -v coredumpctl &>/dev/null; then
            systemd_tmp_core="$(mktemp -d)/core"
            log_message "No local core file; core_pattern is a handler - trying 'coredumpctl dump'..."
            local since_args=()
            [[ $since_ts -gt 0 ]] && since_args=(--since "@$since_ts")
            # systemd-coredump processes dumps asynchronously: the journal
            # entry may not exist yet right after the crash - retry briefly.
            local try ok=1
            for try in 1 2 3 4 5; do
                if coredumpctl dump "${HL##*/}" "${since_args[@]}" --output="$systemd_tmp_core" >/dev/null 2>&1 && [[ -s "$systemd_tmp_core" ]]; then
                    ok=1
                    break
                fi
                ok=0
                [[ $try -lt 5 ]] && sleep 1
            done
            if [[ $ok -eq 1 ]]; then
                CORE_FILE="$systemd_tmp_core"
            else
                rm -rf "$(dirname "$systemd_tmp_core")"
                systemd_tmp_core=""
                log_message "Warning: coredumpctl dump failed (journal access denied, no matching dump, or dump not processed yet)."
            fi
        fi
    fi

	{
		echo -e "\n======================================================================"
		echo "=== CRASH REPORT - $(date) ==="
		echo "======================================================================"
		echo ""
		echo "Exit Code:   $exitcode"
		if [[ "$exitcode" -gt 128 ]]; then
			echo "Stop Signal: $(kill -l "$(( exitcode - 128 ))" 2>/dev/null || echo "signal $(( exitcode - 128 ))")"
		fi
		echo "Start Line:  $HL ${SRV_ARGS[*]}"
		echo ""
		echo "----------------------------------------------------------------------"
		echo "--- SYSTEM STATE AT TIME OF CRASH ---"
		echo "----------------------------------------------------------------------"
		echo "[*] Kernel Version:"; uname -a; echo ""
		echo "[*] System Uptime and Load:"; uptime; echo ""
		echo "[*] CPU Usage (top 15 processes):"; ps -eo pid,pcpu,pmem,user,args --sort=-pcpu | head -n 15; echo ""
		echo "[*] Memory Usage (MB):"; free -m; echo ""
		local swapinfo; swapinfo="$(cat /proc/swaps 2>&1 | tail -n +2)"
		echo "[*] Swap:"; if [[ -n "$swapinfo" ]]; then echo "$swapinfo"; else echo "(no swap enabled)"; fi; echo ""
		echo "[*] Top 10 processes by memory (RSS):"; ps -eo pid,rss,pmem,user,args --sort=-rss | head -n 11; echo ""
		echo "[*] Disk Space Usage:"; df -h; echo ""
		echo "[*] Environment (engine-related):"; env | grep -E '^(LD_LIBRARY_PATH|LD_PRELOAD|MALLOC_CHECK_|MALLOC_PERTURB_|TERM|HOME)'; if [[ -n "$HEAP_PRELOAD" ]]; then echo "LD_PRELOAD=$HEAP_PRELOAD  (applied to the server process via launcher)"; fi; echo " (STEAM_*/PATH are withheld from the report on purpose)"; echo ""
		echo "[*] Binary checksum ($HL):"; md5sum "$HL" 2>&1; echo ""
		echo "[*] Library checksums (all .so in server root):"; find . -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 md5sum 2>/dev/null; echo ""
		echo "[*] Game DLLs ($GAME/dlls):"; find "$GAME/dlls" -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 md5sum 2>/dev/null; echo ""
		echo "[*] Core dump settings:"; echo "ulimit -c: $(ulimit -c)"; echo "kernel.core_pattern: $(cat /proc/sys/kernel/core_pattern 2>&1)"; echo ""
		echo "[*] Listening sockets (TCP):"; if ss -ltnp >/dev/null 2>&1; then ss -ltnp | head -n 15; else echo "(unavailable: needs root for -p)"; ss -ltn | head -n 15; fi; echo ""
		echo "[*] Listening sockets (UDP):"; if ss -ulnp >/dev/null 2>&1; then ss -ulnp | head -n 15; else echo "(unavailable: needs root for -p)"; ss -uln | head -n 15; fi; echo ""
		echo "[*] Kernel Messages (dmesg last 50, common noise filtered):"; if dmesg >/dev/null 2>&1; then dmesg | grep -viE 'UFW BLOCK|audit:' | tail -n 50; else echo "(unavailable without root)"; fi; echo ""

		if [[ -n "$CONSOLE_TAIL" ]]; then
			echo "----------------------------------------------------------------------"
			echo "--- SERVER OUTPUT (stdout+stderr, last 100 lines) ---"
			echo "----------------------------------------------------------------------"
			echo "$CONSOLE_TAIL"
			echo ""
		fi

		if [[ -z "$CORE_FILE" || ! -f "$CORE_FILE" ]]; then
			echo "--- GDB ANALYSIS (SKIPPED: Core dump file not found) ---"
		else
			echo "----------------------------------------------------------------------"
			echo "--- GDB ANALYSIS of Core Dump: '$CORE_FILE' ---"
			echo "----------------------------------------------------------------------"
			# One batch invocation (the core is loaded once) with section
			# headers printed by gdb itself via echo - the report stays
			# split into labeled, greppable sections.
			GDB_CMDS_FILE=$(mktemp)
			cat > "$GDB_CMDS_FILE" <<-'EOF'
			set pagination off
			set confirm off
			echo \n=== Stacktrace ===\n\n
			info threads
			thread apply all bt full
			echo \n=== Registers and frame info ===\n\n
			info registers
			info frame
			info args
			info locals
			echo \n=== Disassembly (32 instructions before $pc) ===\n\n
			x/32i $pc-32
			echo \n=== Memory mappings ===\n\n
			info proc mappings
			echo \n=== Shared libraries ===\n\n
			info sharedlibrary
			quit
			EOF

			# Stripped binaries pepper every frame with "No symbol table info" - drop the noise.
			"$GDB" -nx "$HL" "$CORE_FILE" -x "$GDB_CMDS_FILE" -batch 2>&1 | sed '/No symbol table info available/d'

			rm -f "$GDB_CMDS_FILE"; GDB_CMDS_FILE=""
			if [[ -n "$systemd_tmp_core" ]]; then
				# Exported systemd dump: not ours to keep - remove after analysis.
				rm -f "$systemd_tmp_core"
				rmdir "$(dirname "$systemd_tmp_core")" 2>/dev/null
				systemd_tmp_core=""
				echo ""
				echo "Core dump was exported from systemd-coredump and removed after analysis."
			else
				local new_core_name="crash_core.$(date +%F_%T.%N).dmp"
				mv "$CORE_FILE" "$new_core_name"
				local -a old_dumps=()
				while IFS= read -r f; do old_dumps+=("$f"); done < <(find . -maxdepth 1 -name 'crash_core.*.dmp' -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2-)
				if [[ ${#old_dumps[@]} -gt 0 ]]; then
					rm -f "${old_dumps[@]}"
					log_message "Old core dumps rotated (kept 3 newest)." >&2
					echo "Old core dumps rotated (kept 3 newest)."
				fi
				echo ""
				echo "Core dump file has been analyzed and renamed to '$new_core_name'"
			fi
		fi
		echo "======================================================================"
		echo "=== END OF CRASH REPORT ==="
		echo "======================================================================"

	} >> "$CRASH_LOG_FILE"

	# Tighten the file's mode right after writing (umask alone is racy
	# for the >>-created file when it did not exist yet).
	chmod 600 "$CRASH_LOG_FILE"
}

run() {
	log_message "Server command: $HL ${SRV_ARGS[*]}"
	if [[ -n "$RESTART" ]]; then
		log_message "Auto-restart is enabled. Press Ctrl+C in the server console to stop."
		local CRASH_STREAK=0
		while true; do
			log_message "Starting server..."
			local start_ts; start_ts=$(date +%s)
			launch_server
			local retval=$?
			local life=$(( $(date +%s) - start_ts ))
			if [[ $retval -eq 0 || $retval -eq 130 ]]; then
                if [[ $retval -eq 130 ]]; then
					log_message "Server stopped by operator (SIGINT). Exiting script."
				else
					log_message "Server shut down cleanly. Exiting script."
				fi
                break
            fi
			# A crash after HEALTHY_UPTIME seconds of stable run is not part
			# of a crash loop - reset the streak.
			if [[ $life -ge $HEALTHY_UPTIME ]]; then
				CRASH_STREAK=0
			fi
			CRASH_STREAK=$(( CRASH_STREAK + 1 ))
			debugcore $retval "$start_ts"
			if [[ $CRASH_STREAK -ge $STREAK_LIMIT ]]; then
				log_message "Crash-loop detected: $CRASH_STREAK consecutive crashes without reaching ${HEALTHY_UPTIME}s uptime."
				log_message "Giving up - fix the cause, then start manually. Last exit code: $retval."
				return 1
			fi
			log_message "Server process crashed (streak $CRASH_STREAK/$STREAK_LIMIT). Restarting in $TIMEOUT seconds..."
			sleep "$TIMEOUT"
		done
		return 0
	else
		log_message "Starting server (no restart)"
		local start_ts; start_ts=$(date +%s)
		launch_server
		local exitcode=$?
		debugcore $exitcode "$start_ts"
		return $exitcode
	fi
}

# --- Main Execution ---
init "$@"
run
exitcode=$?
log_message "Script finished."
exit $exitcode
