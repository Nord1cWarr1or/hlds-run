#!/bin/bash
#
#       HLDS crash-diagnostics wrapper, drop-in for Valve hlds_run.
#       Runs the server on a pty (console mirrored to terminal and to
#       a temp typescript); auto-restart with a crash-loop guard.
#       With -debug: core dumps + full crash reports (system state,
#       console tail, GDB analysis).
#
#       Improvements over the original Valve hlds_run:
#       - Real crash reports instead of a bare `bt` in debug.log:
#         signal, system state, engine env, md5 of the binary and all
#         .so, core dump settings, console tail, full GDB analysis
#         (bt full all threads, registers, mappings, shared libs).
#       - Every crash gets its own timestamped crash_report file
#         (original appends everything into one debug.log).
#       - Console capture via pty: operator keeps the live view and
#         the report gets the last 100 lines of both streams, CR and
#         ANSI codes stripped. Fallback to plain tty if `script` is
#         missing (with a warning).
#       - systemd-coredump supported: if core_pattern is a pipe
#         handler, the dump is exported via coredumpctl.
#       - Core dump management: after analysis the core is renamed
#         and old dumps are rotated (3 newest kept); original left
#         cores untracked.
#       - Crash-loop guard: gives up after repeated quick crashes
#         (original restarts forever).
#       - Debug mode: `ulimit -c unlimited` (original: 2000) + full
#         crash reports; -debug alone never touches the heap. Heap
#         debugging is opt-in: -malloc-check (MALLOC_CHECK_=3, with the
#         libc_malloc_debug preload on glibc >= 2.34) and
#         -malloc-perturb (MALLOC_PERTURB_=170). CAVEAT: the debug
#         malloc changes the heap layout - layout-sensitive crashes can
#         move or vanish entirely under -malloc-check (verified live:
#         crashes at SteamGameServer_Init stopped reproducing with the
#         preload on glibc 2.41).
#       - Exit signal is decoded into a name in the report.
#       - Strict arg parsing: script-only args (-debug/-norestart/
#         -timeout/-binary) are never leaked to the server; missing
#         values or a non-numeric -timeout are hard errors (original
#         silently misparsed such lines).
#       - hlds_linux exit code is propagated with `script -e`
#         (some old wrapper versions always exited 0).
#

export LD_LIBRARY_PATH=".${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
set -o pipefail

# --- Temporary-state tracking + cleanup on any exit path ---
CAPLOG_FILE=""
GDB_CMDS_FILE=""
LAUNCHER_FILE=""
RUN_TMP_DIR=""
systemd_tmp_core=""
systemd_tmp_core_dir=""
declare -A CORE_BEFORE=()

# Invoked indirectly: `trap cleanup_temp EXIT` (SC2329 cannot see that).
# shellcheck disable=SC2329
cleanup_temp() {
	[[ -n "$CAPLOG_FILE" ]] && { rm -f "$CAPLOG_FILE"; CAPLOG_FILE=""; }
	[[ -n "$GDB_CMDS_FILE" ]] && { rm -f "$GDB_CMDS_FILE"; GDB_CMDS_FILE=""; }
	[[ -n "$LAUNCHER_FILE" ]] && { rm -f "$LAUNCHER_FILE"; LAUNCHER_FILE=""; }
	[[ -n "$systemd_tmp_core" ]] && { rm -f -- "$systemd_tmp_core"; systemd_tmp_core=""; }
	[[ -n "$systemd_tmp_core_dir" ]] && { rm -rf -- "$systemd_tmp_core_dir"; systemd_tmp_core_dir=""; }
	[[ -n "$RUN_TMP_DIR" ]] && { rm -rf -- "$RUN_TMP_DIR"; RUN_TMP_DIR=""; }
}

# Bash skips the EXIT trap on a fatal signal - route INT/TERM/HUP through
# exit so the cleanup still runs. HUP matters in production: screen/SSH
# session death hits the whole process group with it.
trap 'trap - INT; exit 130' INT
trap 'trap - TERM; exit 143' TERM
trap 'trap - HUP; exit 129' HUP
trap cleanup_temp EXIT

# --- Global Configuration ---
GAME="valve"
DEBUG=0
MALLOC_CHECK_ON=0
MALLOC_PERTURB_ON=0
# -debuginfod: let GDB fetch system-lib debug symbols during report
# analysis (gdb >= 10.1 built with debuginfod). Off by default: it
# sends the build-ids of the server's libraries to external symbol
# servers and adds network latency to every report.
DEBUGINFOD_ON=0
RESTART="yes"
HL="./hlds_linux"
TIMEOUT=10
GDB="gdb"
# Crash-loop guard: stop after STREAK_LIMIT crashes that happened while the
# server ran for less than HEALTHY_UPTIME seconds (quick-fail loop).
STREAK_LIMIT=5
HEALTHY_UPTIME=300
# LD_PRELOAD path resolved by init() in -debug mode; applied to the
# server process only (not the wrapper's own helpers).
HEAP_PRELOAD=""
# --- End of Global Configuration ---


init() {
	SRV_ARGS=()
	# Operator LD_PRELOAD out of the SHELL scope immediately (audit H1):
	# every helper below (date in log_message, mktemp, script, gdb check)
	# is 64-bit and would print ELF-class noise otherwise. The value is
	# kept and re-attached to the server run only, never silently dropped.
	OPERATOR_PRELOAD="$LD_PRELOAD"
	unset LD_PRELOAD
	while [[ $# -gt 0 ]]; do
		case "$1" in
		"-game") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; GAME="$2"; SRV_ARGS+=("-game" "$2"); shift 2 ;;
		"-binary") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; HL="$2"; shift 2 ;;
		"-timeout")
			[[ $# -ge 2 ]] || { echo "Error: '-timeout' requires a value."; exit 1; }
			[[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "Error: '-timeout' value must be a positive integer."; exit 1; }
			TIMEOUT="$2"; shift 2 ;;
		"-debug") DEBUG=1; shift ;;
		"-malloc-check") MALLOC_CHECK_ON=1; shift ;;
		"-malloc-perturb") MALLOC_PERTURB_ON=1; shift ;;
		"-debuginfod") DEBUGINFOD_ON=1; shift ;;
		"-norestart") RESTART=""; shift ;;
		*) SRV_ARGS+=("$1"); shift ;;
		esac
	done
	if [[ ! -d "$GAME" ]]; then echo "Error: Invalid game type '$GAME'"; exit 1; fi
	if [[ ! -x "$HL" ]]; then echo "Error: Binary '$HL' not found or not executable."; exit 1; fi
	CAPTURE=1
	if ! command -v script &> /dev/null; then
		echo "Warning: 'script' not found - capture disabled, plain tty mode."
		CAPTURE=0
	fi
	# Private per-run directory for the launcher and console capture. If it
	# cannot be created or secured, the server still runs (plain fallback):
	# only capture is given up, honestly. coredumpctl exports degrade the
	# same way - they honestly skip without the directory.
	if ! RUN_TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/hlds-run.XXXXXX" 2>/dev/null) || ! chmod 700 "$RUN_TMP_DIR" 2>/dev/null; then
		RUN_TMP_DIR=""
		CAPTURE=0
		echo "Warning: cannot create a private temporary directory in TMPDIR='${TMPDIR:-/tmp}' - console capture disabled, plain tty mode."
	fi
	# Sweep private-directory leftovers from runs killed untrap-ably
	# (SIGKILL, power loss - SIGHUP is handled by the trap above). Our
	# namespace only; the one-hour guard keeps a concurrently written
	# directory (fresh mtime) untouched.
	local stale
	stale="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'hlds-run.*' -mmin +60 2>/dev/null)"
	if [[ -n "$stale" ]]; then
		# rm -rf via -exec, not -delete: -delete only removes entries
		# matching the predicates, so a stale directory with files inside
		# would fail with "Directory not empty" and be silently skipped.
		find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'hlds-run.*' -mmin +60 -exec rm -rf -- {} + 2>/dev/null || true
		log_message "Swept $(echo "$stale" | wc -l) stale private temporary director(ies) from TMPDIR."
	fi
	if [[ "$DEBUG" -eq 1 ]]; then
		echo "Debug mode is enabled. Core dumps will be generated on crash."
		ulimit -c unlimited
		if [[ "$(ulimit -c)" == "0" ]]; then
			echo "Warning: core dumps could not be enabled (hard limit is 0 - container or service limits?)."
		fi
		if ! command -v "$GDB" &> /dev/null; then echo "Warning: 'gdb' not found."; fi
		# -debuginfod: probe once whether this gdb understands the setting
		# (needs gdb >= 10.1 built with debuginfod). A failed probe
		# downgrades the flag with a warning instead of feeding gdb an
		# unknown command mid-batch.
		if [[ "$DEBUGINFOD_ON" -eq 1 ]]; then
			if "$GDB" -nx -batch -ex 'set debuginfod enabled on' >/dev/null 2>&1; then
				echo "debuginfod enabled for GDB analysis (URLs: gdb defaults, override via DEBUGINFOD_URLS)."
			else
				DEBUGINFOD_ON=0
				echo "Warning: this gdb has no debuginfod support - '-debuginfod' ignored."
			fi
		fi
	fi
	# Loud heap-corruption detection - OPT-IN via -malloc-check. Deliberately
	# NOT part of -debug: the debug malloc rearranges the heap, and -debug
	# must stay pure observability (reports + core dumps) so it can be used
	# to catch layout-sensitive crashes that heap changes would hide.
	#
	# glibc >= 2.34 (Debian 12+, Arch, Ubuntu 22+): the debug malloc
	# lives in libc_malloc_debug.so and is NOT active unless preloaded.
	# On older glibc (Debian 11, CentOS) the variable works by itself.
	# Detect the 32-bit object (the HLDS binary is 32-bit); on systems
	# without it the plain MALLOC_CHECK_ export below still applies.
	if [[ "$MALLOC_CHECK_ON" -eq 1 ]]; then
		local mdebug_lib ldconfig_bin candidate
		mdebug_lib="$(ldconfig -p 2>/dev/null | awk '/libc_malloc_debug/ && /\(libc6\) =>/ {print $NF; exit}')"
		if [[ -z "$mdebug_lib" ]]; then
			# ldconfig lives in /usr/sbin - not in a regular user's PATH
			# (e.g. the service user running this wrapper).
			for ldconfig_bin in /sbin/ldconfig /usr/sbin/ldconfig; do
				[[ -x "$ldconfig_bin" ]] || continue
				mdebug_lib="$("$ldconfig_bin" -p 2>/dev/null | awk '/libc_malloc_debug/ && /\(libc6\) =>/ {print $NF; exit}')"
				[[ -n "$mdebug_lib" ]] && break
			done
		fi
		if [[ -z "$mdebug_lib" ]]; then
			# Last resort: known multiarch locations of the 32-bit object.
			for candidate in /usr/lib/i386-linux-gnu/libc_malloc_debug.so.0 /usr/lib32/libc_malloc_debug.so.0 /lib32/libc_malloc_debug.so.0 /usr/lib/libc_malloc_debug.so.0; do
				[[ -e "$candidate" ]] && { mdebug_lib="$candidate"; break; }
			done
		fi
		if [[ -n "$mdebug_lib" ]]; then
			# NOT exported globally: every 64-bit helper of the wrapper
			# (date, mktemp, script, launcher bash) would inherit it and
			# print "wrong ELF class: ELFCLASS32" noise. The preload is
			# injected into the launcher/env so only the server process
			# (32-bit) sees it.
			HEAP_PRELOAD="$mdebug_lib"
			echo "Heap debugging enabled (-malloc-check): $mdebug_lib will be preloaded into the server (glibc >= 2.34 requires it)."
		else
			HEAP_PRELOAD=""
			echo "Heap debugging enabled (-malloc-check): MALLOC_CHECK_ set natively (no libc_malloc_debug found)."
		fi
		export MALLOC_CHECK_=3
		# CAVEAT: even without the preload, on older glibc the native debug
		# malloc also rearranges the heap - layout-sensitive crashes can
		# move or vanish under -malloc-check (see README, verified on
		# Debian 13).
	fi
	if [[ "$MALLOC_PERTURB_ON" -eq 1 ]]; then
		# Fill fresh allocations with garbage (0xAA) and freed memory with
		# ~0xAA so use-after-free and reads of freed/stale data trip almost
		# immediately. Adds memset on every malloc/free - noticeable
		# overhead. Works on every glibc, no preload needed. Combine with
		# -malloc-check (and -debug) for the maximum-radar session.
		export MALLOC_PERTURB_=170
		echo "Heap debugging enabled (-malloc-perturb): MALLOC_PERTURB_=170 (allocations filled with 0xAA - extra overhead on every malloc/free)."
	fi
	# The operator's LD_PRELOAD is never dropped: it is handed to the server
	# (launcher export or env prefix) together with the wrapper's heap-debug
	# library. Decide and report it once here, not on every launch.
	if [[ -n "$OPERATOR_PRELOAD" ]]; then
		if [[ -n "$HEAP_PRELOAD" && "$OPERATOR_PRELOAD" == "$HEAP_PRELOAD" ]]; then
			log_message "Operator LD_PRELOAD equals the wrapper's heap-debug library - not duplicated."
			OPERATOR_PRELOAD=""
		else
			log_message "Operator LD_PRELOAD passed to the server: $OPERATOR_PRELOAD"
		fi
	fi
}

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] - $1"
}

# Timestamp for artifact names: <format>.<milliseconds>. %N prints 9
# digits of nanoseconds - keep the first 3 (milliseconds): still
# collision-proof for two artifacts in one second, 6 characters
# shorter. Truncate only a real %N tail (dot + exactly 9 digits): if
# %N is unsupported, the name just stays longer instead of getting
# mangled.
now_stamp() {
	local ts
	ts="$(date +"$1.%N")"
	[[ $ts =~ \.[0-9]{9}$ ]] && ts="${ts%??????}"
	printf '%s' "$ts"
}

# Capture: run on a pty so the operator keeps the live console view while
# a temp typescript collects stdout+stderr for the crash report tail.

make_launcher() {
	# `script -c` re-parses its command line through $SHELL (dash, fish...),
	# and printf %q quoting is bash-specific - a mismatched shell mangles
	# args with spaces/UTF-8. Instead: write a tiny launcher with a bash
	# shebang; whatever shell `script` uses, it just executes that file,
	# and the args are parsed by our bash. Reuses the %q technique, but
	# only where it is guaranteed valid.
	LAUNCHER_FILE=$(mktemp "$RUN_TMP_DIR/launcher.XXXXXX") || { echo "Error: cannot create launcher temp file - aborting before launching the server."; exit 1; }
	if [[ -z "$LAUNCHER_FILE" ]]; then echo "Error: empty launcher temp file name - aborting before launching the server."; exit 1; fi
	printf '#!/bin/bash\n' > "$LAUNCHER_FILE"
	if [[ -n "$HEAP_PRELOAD" || -n "$operator_preload" ]]; then
		# Set inside the launcher: `script` and the launcher bash itself
		# run without the variable (no ELF-class noise from 64-bit
		# helpers); `exec` passes it only to the server process. Both the
		# wrapper's own -debug preload and the operator's own LD_PRELOAD
		# land here (audit H1: operator's value is never silently dropped).
		local all_preloads=""
		[[ -n "$HEAP_PRELOAD" ]] && all_preloads="$HEAP_PRELOAD"
		[[ -n "$operator_preload" ]] && all_preloads="${all_preloads:+$all_preloads:}$operator_preload"
		printf 'export LD_PRELOAD=%q\n' "$all_preloads" >> "$LAUNCHER_FILE"
	fi
	printf 'exec %q ' "$HL" >> "$LAUNCHER_FILE"
	local a
	for a in "${SRV_ARGS[@]}"; do printf '%q ' "$a" >> "$LAUNCHER_FILE"; done
	printf '2>&1\n' >> "$LAUNCHER_FILE"
	chmod +x "$LAUNCHER_FILE"
}

launch_server() {
	CONSOLE_TAIL=""
	# operator_preload comes from init(): the operator's LD_PRELOAD was moved
	# out of the SHELL scope there, deduplicated against the heap-debug
	# library and re-attached to the server run here (capture: launcher
	# export; non-capture: env prefix).
	local operator_preload="${OPERATOR_PRELOAD:-}"
	# Keep the typescript inside this run's private temporary directory; it is
	# removed on exit and cannot collide with another wrapper instance.
	# --output-limit is a runaway-console safety net (util-linux >= 2.32);
	# failures to apply it are harmless - the limit is far above the
	# ~100 lines the report actually reads.
	CAPLOG_FILE=$(mktemp "$RUN_TMP_DIR/caplog.XXXXXX") || CAPLOG_FILE=""
	if [[ -z "$CAPLOG_FILE" ]]; then
		# Primary path lost writability mid-run (probe at init passed) -
		# fall back to TMPDIR rather than launching with an empty name
		# (an empty caplog name would prevent `script` from spawning the
		# server at all and fake a crash, audit G1).
		log_message "Warning: console capture file could not be created - capture disabled, plain tty mode for this run."
		CAPTURE=0
	fi
	local limit_args=()
	if script --help 2>&1 | grep -q -- '--output-limit'; then
		limit_args=(--output-limit 200MiB)
	fi
	if [[ "$CAPTURE" -eq 1 ]]; then
		make_launcher
		if [[ ${#limit_args[@]} -gt 0 ]]; then
			# -c BEFORE the positional file: under POSIXLY_CORRECT getopt
			# stops parsing at the first positional argument (audit G4).
			script -q -e "${limit_args[@]}" -c "\"$LAUNCHER_FILE\"" "$CAPLOG_FILE"
		else
			script -qec "\"$LAUNCHER_FILE\"" "$CAPLOG_FILE"
		fi
		local exitcode=$?
		rm -f "$LAUNCHER_FILE"; LAUNCHER_FILE=""
	else
		local combined_preload=""
		[[ -n "$HEAP_PRELOAD" ]] && combined_preload="$HEAP_PRELOAD"
		[[ -n "$operator_preload" ]] && combined_preload="${combined_preload:+$combined_preload:}$operator_preload"
		if [[ -n "$combined_preload" ]]; then
			# No capture: still scope the preload to the server only.
			env "LD_PRELOAD=$combined_preload" "$HL" "${SRV_ARGS[@]}"
		else
			"$HL" "${SRV_ARGS[@]}"
		fi
		local exitcode=$?
	fi
	if [[ -f "$CAPLOG_FILE" ]]; then
		# The pty turns \n into \r\n and the engine prints ANSI colors:
		# strip CRs and escape sequences (ESC and '[' are literal here, so the
		# substitution uses no GNU-only escapes and stays quiet under
		# POSIXLY_CORRECT), then drop `script` annotations.
		CONSOLE_TAIL=$(tail -n 100 "$CAPLOG_FILE" | tr -d '\r' | sed $'s/\033[[][0-9;]*[A-Za-z]//g' | grep -v '^Script \(started\|done\)' | grep -v 'from LD_PRELOAD cannot be preloaded')
		# --output-limit stops WRITING when reached: the tail is frozen at
		# the truncation moment, not at the crash. Detect the marker so the
		# report can warn about a possibly stale tail (audit H4).
		if grep -q '<max output size exceeded>' "$CAPLOG_FILE" 2>/dev/null; then
			CONSOLE_TAIL="[!] console capture was truncated (output limit reached) - this tail may be stale.
$CONSOLE_TAIL"
		fi
		rm -f "$CAPLOG_FILE"
		CAPLOG_FILE=""
	fi
	return $exitcode
}

snapshot_cores() {
	CORE_BEFORE=()
	local path identity
	while IFS= read -r -d '' path; do
		identity=$(stat -c '%d:%i' -- "$path" 2>/dev/null) || continue
		CORE_BEFORE["$path"]=$identity
	done < <(find . -maxdepth 1 -type f -name 'core*' -print0 2>/dev/null)
}

debugcore() {
	local exitcode=$1
	local since_ts=${2:-0}
	# Clean stop (operator Ctrl+C or TERM) is never a crash - in either mode.
	# The console tail is still worth keeping for the operator: save it
	# next to the reports as a stop-log (audit H3).
	if [[ $exitcode -eq 130 || $exitcode -eq 143 ]]; then
		if [[ -n "$CONSOLE_TAIL" ]]; then
			local stop_log
			stop_log="server_stop_$(now_stamp '%Y-%m-%d_%H-%M-%S').log"
			printf '%s\n' "Server stopped with exit code $exitcode ($(date)). Last console lines:" "$CONSOLE_TAIL" > "$stop_log"
			chmod 600 "$stop_log"
			# A stop-log is written on every clean stop, so rotate them like
			# the core dumps: keep the 3 newest.
			local -a old_stops=()
			while IFS= read -r f; do old_stops+=("$f"); done < <(find . -maxdepth 1 -name 'server_stop_*.log' -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2-)
			if [[ ${#old_stops[@]} -gt 0 ]]; then rm -f "${old_stops[@]}"; fi
		fi
		return
	fi
    if [[ $exitcode -eq 0 || $DEBUG -eq 0 ]]; then
        if [[ $exitcode -ne 0 ]]; then log_message "Server crashed, but debug mode is OFF."; fi
        return
    fi

    log_message "CRASH DETECTED (Exit Code: $exitcode). Generating comprehensive crash report..."

    # Pre-create owner-only BEFORE the >> block below: the file would
    # otherwise spend its whole generation time at umask mode (audit H7).
    local CRASH_LOG_FILE
    CRASH_LOG_FILE="crash_report_$(now_stamp '%Y-%m-%d_%H-%M-%S').txt"
    ( umask 077; : > "$CRASH_LOG_FILE" )
    log_message "Crash report will be saved to: $CRASH_LOG_FILE"

    local CORE_FILE
    # Recorded here, emitted inside the report block below: a note printed
    # to the terminal would not survive in the archived report.
    local core_note=""
    CORE_FILE=""
    local candidate candidate_identity candidate_mtime newest_mtime=""
    while IFS= read -r -d '' candidate; do
        candidate_identity=$(stat -c '%d:%i' -- "$candidate" 2>/dev/null) || continue
        [[ -n "${CORE_BEFORE[$candidate]+present}" && "${CORE_BEFORE[$candidate]}" == "$candidate_identity" ]] && continue
        candidate_mtime=$(stat -c %y -- "$candidate" 2>/dev/null) || continue
        if [[ -z "$CORE_FILE" || "$candidate_mtime" > "$newest_mtime" ]]; then
            CORE_FILE="$candidate"
            newest_mtime="$candidate_mtime"
        fi
    done < <(find . -maxdepth 1 -type f -name 'core*' -print0 2>/dev/null)
    if [[ ! -f "$CORE_FILE" ]]; then
        CORE_FILE=""
    fi
    if [[ -n "$CORE_FILE" ]]; then
        # Never analyze a dump left by an earlier run: only cores created
        # after this server start are trustworthy. Also: a real core is
        # an ELF core file - anything else named core* is not ours.
        local core_mtime
        core_mtime=$(stat -c %Y "$CORE_FILE" 2>/dev/null || echo 0)
        if [[ $core_mtime -lt $since_ts ]]; then
            log_message "Warning: newest core* is older than this server run - ignoring it."
            CORE_FILE=""
        elif [[ -n "$CORE_FILE" ]] && ! command -v file &>/dev/null; then
            # file(1) missing: cannot verify the ELF type. Do NOT reject the
            # dump (mtime already passed) - proceed with GDB, but say so.
            log_message "Warning: 'file' is not installed - skipping the ELF core-file check."
            core_note="--- NOTE: 'file' is not installed; the dump passed the mtime check only."
        elif [[ -n "$CORE_FILE" ]] && ! file "$CORE_FILE" 2>/dev/null | grep -qE 'ELF.*(core|coredump)'; then
            log_message "Warning: newest core* is not a core dump from this server run - ignoring it."
            CORE_FILE=""
        fi
    fi

    # systemd-coredump: kernel.core_pattern is a pipe handler, so no core
    # file is written to disk. Try to export the latest matching dump via
    # coredumpctl (needs journal access; usually root). systemd_tmp_core
    # is a global, so the EXIT cleanup can remove leftovers.
    if [[ -z "$CORE_FILE" ]]; then
        local core_pattern
        core_pattern="$(cat /proc/sys/kernel/core_pattern 2>/dev/null)"
        if [[ "$core_pattern" == "|"* ]] && command -v coredumpctl &>/dev/null; then
            if ! systemd_tmp_core_dir=$(mktemp -d "$RUN_TMP_DIR/coredump.XXXXXX" 2>/dev/null); then
                log_message "Warning: cannot create a private directory for coredumpctl export."
                systemd_tmp_core=""
            else
                systemd_tmp_core="$systemd_tmp_core_dir/core"
            fi
            if [[ -n "$systemd_tmp_core" ]]; then
                log_message "No local core file; core_pattern is a handler - trying 'coredumpctl dump'..."
                local since_args=()
                [[ $since_ts -gt 0 ]] && since_args=(--since "@$since_ts")
                # systemd-coredump processes dumps asynchronously: the journal
                # entry may not exist yet right after the crash - retry briefly.
                local try ok=1
                for try in 1 2 3 4 5; do
                    if coredumpctl dump "${HL##*/}" "${since_args[@]}" --output="$systemd_tmp_core" >/dev/null 2>&1 && [[ -s "$systemd_tmp_core" ]]; then
                        ok=1
                        break
                    fi
                    ok=0
                    [[ $try -lt 5 ]] && sleep 1
                done
                if [[ $ok -eq 1 ]]; then
                    CORE_FILE="$systemd_tmp_core"
                else
                    rm -rf -- "$systemd_tmp_core_dir"
                    systemd_tmp_core=""
                    systemd_tmp_core_dir=""
                    log_message "Warning: coredumpctl dump failed (journal access denied, no matching dump, or dump not processed yet)."
                fi
            fi
        fi
    fi

	{
		echo -e "\n======================================================================"
		echo "=== CRASH REPORT - $(date) ==="
		echo "======================================================================"
		echo ""
		echo "Exit Code:   $exitcode"
		if [[ "$exitcode" -gt 128 ]]; then
			echo "Stop Signal: $(kill -l "$(( exitcode - 128 ))" 2>/dev/null || echo "signal $(( exitcode - 128 ))")"
		fi
		echo "Start Line:  $HL ${SRV_ARGS[*]}"
		echo ""
		echo "----------------------------------------------------------------------"
		echo "--- SYSTEM STATE AT TIME OF CRASH ---"
		echo "----------------------------------------------------------------------"
		echo "[*] Kernel Version:"; uname -a; echo ""
		echo "[*] System Uptime and Load:"; uptime; echo ""
		echo "[*] CPU Usage (top 15 processes):"; ps -eo pid,pcpu,pmem,user,args --sort=-pcpu | head -n 15; echo ""
		echo "[*] Memory Usage (MB):"; free -m; echo ""
		local swapinfo; swapinfo="$(cat /proc/swaps 2>&1 | tail -n +2)"
		echo "[*] Swap:"; if [[ -n "$swapinfo" ]]; then echo "$swapinfo"; else echo "(no swap enabled)"; fi; echo ""
		echo "[*] Top 10 processes by memory (RSS):"; ps -eo pid,rss,pmem,user,args --sort=-rss | head -n 11; echo ""
		echo "[*] Disk Space Usage:"; df -h; echo ""
		echo "[*] Environment (engine-related):"; env | grep -E '^(LD_LIBRARY_PATH|LD_PRELOAD|MALLOC_CHECK_|MALLOC_PERTURB_|TERM|HOME)'; if [[ -n "$HEAP_PRELOAD" ]]; then echo "LD_PRELOAD=$HEAP_PRELOAD  (applied to the server process via launcher)"; fi; echo " (STEAM_*/PATH are withheld from the report on purpose)"; echo ""
		echo "[*] Binary checksum ($HL):"; md5sum "$HL" 2>&1; echo ""
		echo "[*] Library checksums (all .so in server root):"; local so_list; so_list=$(find . -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 -r md5sum 2>/dev/null); [[ -n "$so_list" ]] && echo "$so_list" || echo "(none found)"; echo ""
		echo "[*] Game DLLs ($GAME/dlls):"; local dll_list; dll_list=$(find "$GAME/dlls" -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 -r md5sum 2>/dev/null); [[ -n "$dll_list" ]] && echo "$dll_list" || echo "(none found)"; echo ""
		echo "[*] Core dump settings:"; echo "ulimit -c: $(ulimit -c)"; echo "kernel.core_pattern: $(cat /proc/sys/kernel/core_pattern 2>&1)"; echo ""
		echo "[*] Listening sockets (TCP):"; if ! command -v ss &>/dev/null; then echo "(ss is not installed)"; elif ss -ltnp >/dev/null 2>&1; then ss -ltnp | head -n 15; else echo "(process info unavailable: needs root for -p)"; ss -ltn | head -n 15; fi; echo ""
		echo "[*] Listening sockets (UDP):"; if ! command -v ss &>/dev/null; then echo "(ss is not installed)"; elif ss -ulnp >/dev/null 2>&1; then ss -ulnp | head -n 15; else echo "(process info unavailable: needs root for -p)"; ss -uln | head -n 15; fi; echo ""
		echo "[*] Kernel Messages (last 50, common noise filtered):"
		if dmesg >/dev/null 2>&1; then
			echo "(source: dmesg)"
			dmesg | grep -viE 'UFW BLOCK|audit:' | tail -n 50
		elif command -v journalctl >/dev/null 2>&1 && journalctl -k -q --no-pager >/dev/null 2>&1; then
			# dmesg restricted (kernel.dmesg_restrict=1, Debian default) but the
			# user can read the journal (adm/systemd-journal group) - same
			# kernel buffer, honest source label.
			echo "(source: journalctl -k - dmesg restricted, kernel buffer read via journal access)"
			journalctl -k -q --no-pager 2>/dev/null | grep -viE 'UFW BLOCK|audit:' | tail -n 50
		else
			echo "(unavailable without root)"
		fi
		echo ""

		if [[ -n "$CONSOLE_TAIL" ]]; then
			echo "----------------------------------------------------------------------"
			echo "--- SERVER OUTPUT (stdout+stderr, last 100 lines) ---"
			echo "----------------------------------------------------------------------"
			echo "$CONSOLE_TAIL"
			echo ""
		fi

		if [[ -z "$CORE_FILE" || ! -f "$CORE_FILE" ]]; then
			echo "--- GDB ANALYSIS (SKIPPED: Core dump file not found) ---"
		else
			echo "----------------------------------------------------------------------"
			echo "--- GDB ANALYSIS of Core Dump: '$CORE_FILE' ---"
			echo "----------------------------------------------------------------------"
			if [[ -n "$core_note" ]]; then echo "$core_note"; echo ""; fi
			# Build-ID registry via elfutils: the one identification that
			# survives stripping - the sha1 stamped in every module needs
			# no symbol table. Optional: silently skipped when eu-stack is
			# missing, and on failure the report says so honestly instead
			# of printing raw error noise.
			if command -v eu-stack >/dev/null 2>&1; then
				local eu_out eu_rc
				eu_out="$(eu-stack --core="$CORE_FILE" --executable="$HL" -l 2>&1)"
				eu_rc=$?
				if [[ -n "$eu_out" && $eu_rc -le 1 ]]; then
					echo "--- ELFUTILS BUILD-ID REGISTRY (eu-stack) ---"
					echo ""
					echo "$eu_out"
					echo ""
				else
					echo "--- ELFUTILS BUILD-ID REGISTRY (eu-stack): skipped (rc=$eu_rc, elfutils too old or dump unreadable) ---"
					[[ -n "$eu_out" ]] && sed -n '1,3p' <<< "$eu_out"
					echo ""
				fi
			fi
			# One batch invocation (the core is loaded once) with section
			# headers printed by gdb itself via echo - the report stays
			# split into labeled, greppable sections.
			GDB_CMDS_FILE=$(mktemp)
			# The debuginfod line must precede the analysis commands:
			# symbol fetching happens while the batch runs, not after it.
			if [[ "$DEBUGINFOD_ON" -eq 1 ]]; then
				printf 'set debuginfod enabled on\n' > "$GDB_CMDS_FILE"
			fi
			cat >> "$GDB_CMDS_FILE" <<-'EOF'
			set pagination off
			set confirm off
			set print pretty on
			set print frame-arguments all
			set print array on
			set print null-stop on
			echo \n=== Stacktrace ===\n\n
			info threads
			thread apply all bt full
			echo \n=== Registers and frame info ===\n\n
			info registers
			info frame
			info args
			info locals
			echo \n=== Stack memory at $sp (16 words) ===\n\n
			x/16wx $sp
			echo \n=== Disassembly (32 instructions before $pc) ===\n\n
			x/32i $pc-32
			echo \n=== Memory mappings ===\n\n
			info proc mappings
			echo \n=== Shared libraries ===\n\n
			info sharedlibrary
			quit
			EOF

			# Pure gdb noise, dropped: "No symbol table info" from stripped
			# binaries; xstate warnings (old kernels save a short register
			# note - harmless format mismatch); "deleted /dev/shm" mapping
			# warnings (Steam's temp shared memory is unlinked by design);
			# the [New LWP] roll call (duplicated by info threads below);
			# k0-k7 AVX-512 mask registers a 32-bit server never uses.
			# KEEP the '?? ()' stack frames - stripped or anonymous, they
			# ARE the backtrace.
			"$GDB" -nx "$HL" "$CORE_FILE" -x "$GDB_CMDS_FILE" -batch 2>&1 | \
				sed -e '/No symbol table info available/d' \
					-e '/in core file too small\./d' \
					-e '/during file-backed mapping note processing/d' \
					-e '/^\[New LWP [0-9][0-9]*\]$/d' \
					-e '/^k[0-7][[:space:]][[:space:]]*<unavailable>$/d'

			rm -f "$GDB_CMDS_FILE"; GDB_CMDS_FILE=""
			if [[ -n "$systemd_tmp_core" ]]; then
				# Exported systemd dump: not ours to keep - remove after analysis.
				rm -f "$systemd_tmp_core"
				rmdir -- "$systemd_tmp_core_dir" 2>/dev/null
				systemd_tmp_core=""
				systemd_tmp_core_dir=""
				echo ""
				echo "Core dump was exported from systemd-coredump and removed after analysis."
			else
				local new_core_name
				new_core_name="crash_core.$(now_stamp '%F_%T').dmp"
				if mv "$CORE_FILE" "$new_core_name" 2>/dev/null; then
					local -a old_dumps=()
					while IFS= read -r f; do old_dumps+=("$f"); done < <(find . -maxdepth 1 -name 'crash_core.*.dmp' -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2-)
					if [[ ${#old_dumps[@]} -gt 0 ]]; then
						rm -f "${old_dumps[@]}"
						log_message "Old core dumps rotated (kept 3 newest)." >&2
						echo "Old core dumps rotated (kept 3 newest)."
					fi
					echo ""
					echo "Core dump file has been analyzed and renamed to '$new_core_name'"
				else
					# Say it plainly: the archive/report claim must not outlive
					# the failure (read-only dir, full disk, missing mv...).
					echo ""
					echo "WARNING: the core dump could not be renamed to '$new_core_name' (read-only dir? disk full?) - it stays as '$CORE_FILE'."
				fi
			fi
		fi
		echo "======================================================================"
		echo "=== END OF CRASH REPORT ==="
		echo "======================================================================"

	} >> "$CRASH_LOG_FILE"
}

run() {
	log_message "Server command: $HL ${SRV_ARGS[*]}"
	if [[ -n "$RESTART" ]]; then
		log_message "Auto-restart is enabled. Press Ctrl+C in the server console to stop."
		local CRASH_STREAK=0
		while true; do
			log_message "Starting server..."
			local start_ts; start_ts=$(date +%s)
			snapshot_cores
			launch_server
			local retval=$?
			local life=$(( $(date +%s) - start_ts ))
			if [[ $retval -eq 0 || $retval -eq 130 || $retval -eq 143 ]]; then
				# Keep the console tail of the stopped run (audit H3) - the
				# stop-log is written by debugcore for 130/143, nothing for
				# a plain 0.
				debugcore $retval "$start_ts"
                if [[ $retval -eq 130 ]]; then
					log_message "Server stopped by operator (SIGINT). Exiting script."
				elif [[ $retval -eq 143 ]]; then
					log_message "Server stopped by signal (SIGTERM). Exiting script."
				else
					log_message "Server shut down cleanly. Exiting script."
				fi
                break
            fi
			# A crash after HEALTHY_UPTIME seconds of stable run is not part
			# of a crash loop - reset the streak.
			if [[ $life -ge $HEALTHY_UPTIME ]]; then
				CRASH_STREAK=0
			fi
			CRASH_STREAK=$(( CRASH_STREAK + 1 ))
			debugcore $retval "$start_ts"
			if [[ $CRASH_STREAK -ge $STREAK_LIMIT ]]; then
				log_message "Crash-loop detected: $CRASH_STREAK consecutive crashes without reaching ${HEALTHY_UPTIME}s uptime."
				log_message "Giving up - fix the cause, then start manually. Last exit code: $retval."
				return 1
			fi
			log_message "Server process crashed (streak $CRASH_STREAK/$STREAK_LIMIT). Restarting in $TIMEOUT seconds..."
			sleep "$TIMEOUT"
		done
		return 0
	else
		log_message "Starting server (no restart)"
		local start_ts; start_ts=$(date +%s)
		snapshot_cores
		launch_server
		local exitcode=$?
		debugcore $exitcode "$start_ts"
		# Same wording as in the restart branch: the operator should be able
		# to tell a clean stop from a crash by reading the log tail.
		if [[ $exitcode -eq 130 ]]; then
			log_message "Server stopped by operator (SIGINT). Exiting script."
		elif [[ $exitcode -eq 143 ]]; then
			log_message "Server stopped by signal (SIGTERM). Exiting script."
		elif [[ $exitcode -eq 0 ]]; then
			log_message "Server shut down cleanly. Exiting script."
		fi
		return $exitcode
	fi
}

# --- Main Execution ---
init "$@"
run
exitcode=$?
log_message "Script finished."
exit $exitcode
