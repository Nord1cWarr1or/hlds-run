#!/bin/bash
#
#       HLDS crash-diagnostics wrapper, drop-in for Valve hlds_run.
#       Runs the server; on a crash (after -debug) writes a full
#       crash report: system state, console tail, GDB analysis of the
#       core dump. Auto-restart loop with a crash-loop guard.
#
#       Script-only args, NOT forwarded to hlds_linux:
#         -debug          core dumps + crash reports
#         -norestart      no restart loop, propagate exit code
#         -timeout N      seconds between restarts (default 10)
#         -binary PATH    server binary (default ./hlds_linux)
#
#       Console capture: the server runs on a pty via `script` -
#       stdout+stderr mirrored to the operator's terminal AND a temp
#       typescript; -e keeps the exit code. Last 100 lines of both
#       streams go into the crash report. Falls back to plain tty
#       only if `script` is not installed.
#

export LD_LIBRARY_PATH=".:$LD_LIBRARY_PATH"
set -o pipefail

# --- Global Configuration ---
GAME="valve"
DEBUG=0
RESTART="yes"
HL="./hlds_linux"
TIMEOUT=10
GDB="gdb"
# Crash-loop guard: stop after STREAK_LIMIT crashes that happened while the
# server ran for less than HEALTHY_UPTIME seconds (quick-fail loop).
STREAK_LIMIT=5
HEALTHY_UPTIME=300
# --- End of Global Configuration ---


init() {
	SRV_ARGS=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		"-game") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; GAME="$2"; SRV_ARGS+=("-game" "$2"); shift 2 ;;
		"-binary") [[ $# -ge 2 ]] || { echo "Error: '$1' requires a value."; exit 1; }; HL="$2"; shift 2 ;;
		"-timeout")
			[[ $# -ge 2 ]] || { echo "Error: '-timeout' requires a value."; exit 1; }
			[[ "$2" =~ ^[0-9]+$ ]] || { echo "Error: '-timeout' value must be a positive integer."; exit 1; }
			TIMEOUT="$2"; shift 2 ;;
		"-debug") DEBUG=1; shift ;;
		"-norestart") RESTART=""; shift ;;
		*) SRV_ARGS+=("$1"); shift ;;
		esac
	done
	if [[ ! -d "$GAME" ]]; then echo "Error: Invalid game type '$GAME'"; exit 1; fi
	if [[ ! -x "$HL" ]]; then echo "Error: Binary '$HL' not found or not executable."; exit 1; fi
	CAPTURE=1
	if ! command -v script &> /dev/null; then
		echo "Warning: 'script' not found - capture disabled, plain tty mode."
		CAPTURE=0
	fi
	if [[ "$DEBUG" -eq 1 ]]; then
		echo "Debug mode is enabled. Core dumps will be generated on crash."
		ulimit -c unlimited
		if ! command -v "$GDB" &> /dev/null; then echo "Warning: 'gdb' not found."; fi
		# Loud heap-corruption detection for this debug session only.
		export MALLOC_CHECK_=3
		# OPTIONAL: fill fresh allocations with garbage (0xAA) and freed memory
		# with ~0xAA so use-after-free and reads of freed/stale data trip almost
		# immediately. Adds memset on every malloc/free - noticeable overhead.
		# Uncomment for maximum-radar debugging sessions:
		# export MALLOC_PERTURB_=170
	fi
}

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] - $1"
}

# Capture: run on a pty so the operator keeps the live console view while
# a temp typescript collects stdout+stderr for the crash report tail.
launch_server() {
	CONSOLE_TAIL=""
	local caplog
	caplog=$(mktemp)
	if [[ "$CAPTURE" -eq 1 ]]; then
		script -qec "\"$HL\" ${SRV_ARGS[*]} 2>&1" "$caplog"
		local exitcode=$?
	else
		"$HL" "${SRV_ARGS[@]}"
		local exitcode=$?
	fi
	if [[ -f "$caplog" ]]; then
		# The pty turns \n into \r\n and the engine prints ANSI colors:
		# strip CRs and escape sequences, then drop `script` annotations.
		CONSOLE_TAIL=$(tail -n 100 "$caplog" | tr -d '\r' | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | grep -v '^Script \(started\|done\)')
		rm -f "$caplog"
	fi
	return $exitcode
}

debugcore() {
	local exitcode=$1
    if [[ $exitcode -eq 0 || $DEBUG -eq 0 ]]; then
        if [[ $exitcode -ne 0 ]]; then log_message "Server crashed, but debug mode is OFF."; fi
        return
    fi

    log_message "CRASH DETECTED (Exit Code: $exitcode). Generating comprehensive crash report..."

    local CRASH_LOG_FILE="crash_report_$(date +'%Y-%m-%d_%H-%M-%S').txt"
    log_message "Crash report will be saved to: $CRASH_LOG_FILE"

    local CORE_FILE
    CORE_FILE=$(find . -maxdepth 1 -name 'core*' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
    if [[ ! -f "$CORE_FILE" ]]; then
        CORE_FILE=""
    fi

    # systemd-coredump: kernel.core_pattern is a pipe handler, so no core
    # file is written to disk. Try to export the latest matching dump via
    # coredumpctl (needs journal access; usually root).
    local systemd_tmp_core=""
    if [[ -z "$CORE_FILE" ]]; then
        local core_pattern
        core_pattern="$(cat /proc/sys/kernel/core_pattern 2>/dev/null)"
        if [[ "$core_pattern" == "|"* ]] && command -v coredumpctl &>/dev/null; then
            systemd_tmp_core="$(mktemp -d)/core"
            log_message "No local core file; core_pattern is a handler - trying 'coredumpctl dump'..."
            if coredumpctl dump "${HL##*/}" --output="$systemd_tmp_core" >/dev/null 2>&1 && [[ -s "$systemd_tmp_core" ]]; then
                CORE_FILE="$systemd_tmp_core"
            else
                rm -rf "$(dirname "$systemd_tmp_core")"
                systemd_tmp_core=""
                log_message "Warning: coredumpctl dump failed (journal access denied or no matching dump)."
            fi
        fi
    fi

	{
		echo -e "\n======================================================================"
		echo "=== CRASH REPORT - $(date) ==="
		echo "======================================================================"
		echo ""
		echo "Exit Code:   $exitcode"
		if [[ "$exitcode" -gt 128 ]]; then
			echo "Stop Signal: $(kill -l "$(( exitcode - 128 ))" 2>/dev/null || echo "signal $(( exitcode - 128 ))")"
		fi
		echo "Start Line:  $HL ${SRV_ARGS[*]}"
		echo ""
		echo "----------------------------------------------------------------------"
		echo "--- SYSTEM STATE AT TIME OF CRASH ---"
		echo "----------------------------------------------------------------------"
		echo "[*] Kernel Version:"; uname -a; echo ""
		echo "[*] System Uptime and Load:"; uptime; echo ""
		echo "[*] CPU Usage (top 15 processes):"; ps -eo pid,pcpu,pmem,user,args --sort=-pcpu | head -n 15; echo ""
		echo "[*] Memory Usage (MB):"; free -m; echo ""
		local swapinfo; swapinfo="$(cat /proc/swaps 2>&1 | tail -n +2)"
		echo "[*] Swap:"; if [[ -n "$swapinfo" ]]; then echo "$swapinfo"; else echo "(no swap enabled)"; fi; echo ""
		echo "[*] Top 10 processes by memory (RSS):"; ps -eo pid,rss,pmem,user,args --sort=-rss | head -n 11; echo ""
		echo "[*] Disk Space Usage:"; df -h; echo ""
		echo "[*] Environment (engine-related):"; env | grep -E '^(LD_LIBRARY_PATH|MALLOC_|STEAM|TERM|HOME|PATH)'; echo ""
		echo "[*] Binary checksum (hlds_linux):"; md5sum "$HL" 2>&1; echo ""
		echo "[*] Library checksums (all .so in server root):"; find . -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 md5sum 2>/dev/null; echo ""
		echo "[*] Game DLLs ($GAME/dlls):"; find "$GAME/dlls" -maxdepth 1 -name '*.so' -print0 2>/dev/null | xargs -0 md5sum 2>/dev/null; echo ""
		echo "[*] Core dump settings:"; echo "ulimit -c: $(ulimit -c)"; echo "kernel.core_pattern: $(cat /proc/sys/kernel/core_pattern 2>&1)"; echo ""
		echo "[*] Listening sockets (TCP):"; ss -ltnp 2>&1 | head -n 15; echo ""
		echo "[*] Listening sockets (UDP):"; ss -ulnp 2>&1 | head -n 15; echo ""
		echo "[*] Kernel Messages (dmesg last 50, common noise filtered):"; dmesg 2>&1 | grep -viE 'UFW BLOCK|audit:' | tail -n 50; echo ""

		if [[ -n "$CONSOLE_TAIL" ]]; then
			echo "----------------------------------------------------------------------"
			echo "--- SERVER OUTPUT (stdout+stderr, last 100 lines) ---"
			echo "----------------------------------------------------------------------"
			echo "$CONSOLE_TAIL"
			echo ""
		fi

		if [[ -z "$CORE_FILE" || ! -f "$CORE_FILE" ]]; then
			echo "--- GDB ANALYSIS (SKIPPED: Core dump file not found) ---"
		else
			echo "----------------------------------------------------------------------"
			echo "--- GDB ANALYSIS of Core Dump: '$CORE_FILE' ---"
			echo "----------------------------------------------------------------------"
			cat > gdb_commands.txt <<-EOF
			set pagination off
			set confirm off
			info threads
			thread apply all bt full
			info registers
			x/32i \$pc-32
			info frame
			info args
			info locals
			info proc mappings
			info sharedlibrary
			quit
			EOF

			# Stripped binaries pepper every frame with "No symbol table info" - drop the noise.
			"$GDB" "$HL" "$CORE_FILE" -x gdb_commands.txt -batch 2>&1 | sed '/No symbol table info available/d'

			rm gdb_commands.txt
			if [[ -n "$systemd_tmp_core" ]]; then
				# Exported systemd dump: not ours to keep - remove after analysis.
				rm -f "$systemd_tmp_core"
				rmdir "$(dirname "$systemd_tmp_core")" 2>/dev/null
				echo ""
				echo "Core dump was exported from systemd-coredump and removed after analysis."
			else
				local new_core_name="crash_core.$(date +%F_%T).dmp"
				mv "$CORE_FILE" "$new_core_name"
				ls -1t crash_core.*.dmp 2>/dev/null | tail -n +4 | xargs -r rm -f
				log_message "Old core dumps rotated (kept 3 newest)." >&2
				echo ""
				echo "Core dump file has been analyzed and renamed to '$new_core_name'"
			fi
		fi
		echo "======================================================================"
		echo "=== END OF CRASH REPORT ==="
		echo "======================================================================"

	} >> "$CRASH_LOG_FILE"
}

run() {
	log_message "Server command: $HL ${SRV_ARGS[*]}"
	if [[ -n "$RESTART" ]]; then
		log_message "Auto-restart is enabled. Use Ctrl+C inside the 'screen' console to stop."
		local CRASH_STREAK=0
		while true; do
			log_message "Starting server..."
			local start_ts; start_ts=$(date +%s)
			launch_server
			local retval=$?
			local life=$(( $(date +%s) - start_ts ))
			if [[ $retval -eq 0 || $retval -eq 130 ]]; then
                log_message "Server shut down cleanly. Exiting script."
                break
            fi
			# A crash after HEALTHY_UPTIME seconds of stable run is not part
			# of a crash loop - reset the streak.
			if [[ $life -ge $HEALTHY_UPTIME ]]; then
				CRASH_STREAK=0
			fi
			CRASH_STREAK=$(( CRASH_STREAK + 1 ))
			debugcore $retval
			if [[ $CRASH_STREAK -ge $STREAK_LIMIT ]]; then
				log_message "Crash-loop detected: $CRASH_STREAK consecutive crashes without reaching ${HEALTHY_UPTIME}s uptime."
				log_message "Giving up - fix the cause, then start manually. Last exit code: $retval."
				return 1
			fi
			log_message "Server process crashed (streak $CRASH_STREAK/$STREAK_LIMIT). Restarting in $TIMEOUT seconds..."
			sleep "$TIMEOUT"
		done
		return 0
	else
		log_message "Starting server (no restart)"
		launch_server
		local exitcode=$?
		debugcore $exitcode
		return $exitcode
	fi
}

# --- Main Execution ---
init "$@"
run
exitcode=$?
log_message "Script finished."
exit $exitcode
